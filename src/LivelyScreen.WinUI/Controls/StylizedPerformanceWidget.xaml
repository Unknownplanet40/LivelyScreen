<UserControl
    x:Class="LivelyScreen_WinUI.Controls.StylizedPerformanceWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootContainer" Width="244" Height="108" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Viewbox Stretch="Uniform">
            <!-- Official Windows 11 Lock-Screen Card -->
            <Border x:Name="PillBackdrop"
                    Width="244"
                    Height="108"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="#22FFFFFF"
                    Background="#B8141720"
                    Padding="14,11,14,10">

            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Card Header (System + Live) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE950;" FontSize="11" Foreground="#A8FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock Text="System"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#B5FFFFFF"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="Live"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="10.5"
                               FontWeight="Medium"
                               Foreground="#7AFFFFFF"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Row 1: Stacked CPU & RAM Meters with Thin 3px Win11 Bars -->
                <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="8" VerticalAlignment="Center">

                    <!-- CPU Meter -->
                    <StackPanel x:Name="PanelCpuMeter" Orientation="Vertical" Spacing="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="CPU Load"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="#A8FFFFFF"/>
                            <TextBlock x:Name="TxtCpuVal"
                                       Grid.Column="1"
                                       Text="12%"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FFFFFF"/>
                        </Grid>
                        <ProgressBar x:Name="ProgressCpu"
                                     Value="12"
                                     Maximum="100"
                                     MinHeight="3"
                                     Height="3"
                                     CornerRadius="1.5"
                                     Background="#18FFFFFF"
                                     Foreground="#60CDFF"/>
                    </StackPanel>

                    <!-- RAM Meter -->
                    <StackPanel x:Name="PanelRamMeter" Orientation="Vertical" Spacing="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Memory (RAM)"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="#A8FFFFFF"/>
                            <TextBlock x:Name="TxtRamVal"
                                       Grid.Column="1"
                                       Text="45%"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FFFFFF"/>
                        </Grid>
                        <ProgressBar x:Name="ProgressRam"
                                     Value="45"
                                     Maximum="100"
                                     MinHeight="3"
                                     Height="3"
                                     CornerRadius="1.5"
                                     Background="#18FFFFFF"
                                     Foreground="#60CDFF"/>
                    </StackPanel>

                </StackPanel>
            </Grid>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
