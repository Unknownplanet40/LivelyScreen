<UserControl
    x:Class="LivelyScreen_WinUI.Controls.StylizedWeatherWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootContainer" Width="244" Height="108" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Viewbox Stretch="Uniform">
            <!-- Official Windows 11 Lock-Screen Card -->
            <Border x:Name="PillBackdrop"
                    Width="244"
                    Height="108"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="#22FFFFFF"
                    Background="#B8141720"
                    Padding="14,11,14,10">

            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Card Header (Location + High/Low) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE753;" FontSize="11" Foreground="#A8FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtLocation"
                                   Text="Local Weather"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#B5FFFFFF"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtHighLow"
                               Grid.Column="1"
                               Text="H: 25°  L: 18°"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="10.5"
                               FontWeight="Medium"
                               Foreground="#7AFFFFFF"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Row 1: Main Temperature + Condition -->
                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <FontIcon x:Name="IconWeatherGlow" Glyph="&#xE706;" FontSize="26" Foreground="#30F5C84C"/>
                            <FontIcon x:Name="IconWeather" Glyph="&#xE706;" FontSize="26" Foreground="#F5C84C"/>
                        </Grid>
                        <TextBlock x:Name="TxtTemperature"
                                   Text="22°"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#F8FFFFFF"
                                   VerticalAlignment="Center"
                                   Margin="0,-2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="TxtCondition"
                                   Text="Partly Cloudy"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="#E5FFFFFF"
                                   HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtUnitLabel"
                                   Text="Clear sky"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="10.5"
                                   Foreground="#78FFFFFF"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Subtle Footer -->
                <TextBlock Grid.Row="2"
                           Text="Updated live • Open-Meteo"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="10.5"
                           Foreground="#68FFFFFF"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
