<UserControl
    x:Class="LivelyScreen_WinUI.Controls.StylizedClockWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Micro-fade storyboard for digit changes -->
        <Storyboard x:Name="TickStoryboard">
            <DoubleAnimation Storyboard.TargetName="ContentGrid"
                             Storyboard.TargetProperty="Opacity"
                             From="0.80" To="1.0"
                             Duration="0:0:0.250">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Initial activation fade-in -->
        <Storyboard x:Name="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="PillBackdrop"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0"
                             Duration="0:0:0.750">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <!-- Outer container -->
    <Grid x:Name="RootContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Frosted Glass Pill Backing -->
        <Border x:Name="PillBackdrop"
                CornerRadius="0"
                BorderThickness="0"
                Background="Transparent"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="16,4,16,6">

            <!-- 3-Row Grid layout: ensures Date & Time measure independently without clipping each other -->
            <Grid x:Name="ContentGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Date (Above Time) -->
                <Grid x:Name="PanelDateAbove"
                      Grid.Row="0"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,-8">
                    <!-- Subtle soft ambient aura (zero black) -->
                    <TextBlock x:Name="TxtDateAboveGlow"
                               Text="Sunday, October 18"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="22"
                               FontWeight="Normal"
                               Foreground="#20FFFFFF"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <!-- Main Text -->
                    <TextBlock x:Name="TxtDateAbove"
                               Text="Sunday, October 18"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="22"
                               FontWeight="Normal"
                               Foreground="#F0FFFFFF"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </Grid>

                <!-- Row 1: Time Container (Clean Windows 11 Typography, zero black shadows) -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <!-- Main Time -->
                    <Grid x:Name="PanelTime" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Ultra-subtle soft ambient glow (zero black borders) -->
                        <TextBlock x:Name="TxtTimeGlow"
                                   Text="10:45"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="94"
                                   FontWeight="SemiBold"
                                   Foreground="#28FFFFFF"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                        <!-- Foreground text -->
                        <TextBlock x:Name="TxtTime"
                                   Text="10:45"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="94"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                    </Grid>

                    <!-- Optional AM/PM Badge -->
                    <Grid x:Name="PanelAmPm"
                          Visibility="Collapsed"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,18">
                        <TextBlock x:Name="TxtAmPmGlow"
                                   Text="AM"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#20FFFFFF"/>
                        <TextBlock x:Name="TxtAmPm"
                                   Text="AM"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#F0FFFFFF"/>
                    </Grid>
                </StackPanel>

                <!-- Row 2: Date (Below Time - Windows 11 Default, snug under digits) -->
                <Grid x:Name="PanelDateBelow"
                      Grid.Row="2"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      Margin="0,-16,0,0">
                    <!-- Subtle soft ambient aura (zero black) -->
                    <TextBlock x:Name="TxtDateBelowGlow"
                               Text="Sunday, October 18"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="22"
                               FontWeight="Normal"
                               Foreground="#20FFFFFF"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <!-- Main Text -->
                    <TextBlock x:Name="TxtDateBelow"
                               Text="Sunday, October 18"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="22"
                               FontWeight="Normal"
                               Foreground="#F0FFFFFF"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
