<UserControl
    x:Class="LivelyScreen_WinUI.Controls.StylizedQuoteWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Viewbox x:Name="ScaleViewbox" Width="340" Stretch="Uniform">
            <!-- Literary Quote & Saying Card -->
            <Border x:Name="PillBackdrop"
                    Width="340"
                    CornerRadius="14"
                    BorderThickness="1"
                    BorderBrush="#1FF7F3EB"
                    Padding="24,20,24,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="BgStopStart" Color="#D91E1C24" Offset="0.0"/>
                        <GradientStop x:Name="BgStopEnd" Color="#D5141319" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel x:Name="ContentGrid" Spacing="10">
                    <!-- Top Literary Ornament: Decorative Serif Quote Mark + Subtle Category Label -->
                    <StackPanel x:Name="HeaderOrnamentPanel"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Margin="0,0,0,-2">
                        <TextBlock x:Name="TxtOrnamentMark"
                                   Text="“"
                                   FontFamily="Georgia, Palatino Linotype, Times New Roman"
                                   FontSize="26"
                                   LineHeight="18"
                                   Foreground="#D4B483"
                                   Margin="0,2,0,-4"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtQuoteCategory"
                                   Text="SAYING"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="9.5"
                                   CharacterSpacing="160"
                                   FontWeight="SemiBold"
                                   Foreground="#9A9389"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Primary Hero: The Quote / Saying in Display Typography (with Subtle Readability Shadow Layer) -->
                    <Grid>
                        <TextBlock x:Name="TxtQuoteBodyShadow"
                                   Text="No matter how good you are, the wrong room will never see your value."
                                   FontFamily="Georgia, Sitka Text, Palatino Linotype, Segoe UI Variable Display"
                                   FontSize="16"
                                   FontWeight="Normal"
                                   Foreground="#AA000000"
                                   TextWrapping="Wrap"
                                   MaxLines="5"
                                   LineHeight="23.5"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1.5,0,-1.5"
                                   IsHitTestVisible="False"/>
                        <TextBlock x:Name="TxtQuoteBody"
                                   Text="No matter how good you are, the wrong room will never see your value."
                                   FontFamily="Georgia, Sitka Text, Palatino Linotype, Segoe UI Variable Display"
                                   FontSize="16"
                                   FontWeight="Normal"
                                   Foreground="#F7F3EB"
                                   TextWrapping="Wrap"
                                   MaxLines="5"
                                   LineHeight="23.5"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- Secondary: Author & Source (Automatically Collapsed when empty or disabled) -->
                    <TextBlock x:Name="TxtAuthorSource"
                               Text="— 50 Cent  •  Get Rich or Die Tryin"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="11.5"
                               FontWeight="Medium"
                               Foreground="#D4B483"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed"/>

                    <!-- Optional Tertiary: Origin & Cultural Meaning / Context & Meaning -->
                    <StackPanel x:Name="MeaningContainer" Spacing="5" Margin="0,2,0,0">
                        <!-- Subtle Accent to Transparent Hairline Divider -->
                        <Border x:Name="DividerMeaning" Height="1" Margin="0,0,0,4">
                            <Border.Background>
                                <LinearGradientBrush x:Name="DividerGradient" StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="DividerStop0" Color="#55D4B483" Offset="0.0"/>
                                    <GradientStop x:Name="DividerStop1" Color="#18F7F3EB" Offset="0.65"/>
                                    <GradientStop x:Name="DividerStop2" Color="#00F7F3EB" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <TextBlock x:Name="TxtMeaningHeading"
                                   Text="ORIGIN &amp; CULTURAL MEANING"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="9"
                                   CharacterSpacing="120"
                                   FontWeight="SemiBold"
                                   Foreground="#7E7970"/>

                        <TextBlock x:Name="TxtMeaningBody"
                                   Text="If you're in a place that doesn't appreciate you, your effort won't be recognized, no matter how skilled you are."
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="11.5"
                                   Foreground="#A8A39B"
                                   TextWrapping="Wrap"
                                   MaxLines="4"
                                   LineHeight="16.5"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
