                                                                              Grid.Row="1" Grid.Column="1"
                                                                              QuoteScale="0.26"
                                                                              CanDrag="True"
                                                                              DragStarting="OnWidgetBadgeDragStarting"
                                                                              Tag="Quote"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Visibility="Collapsed"/>

                                                <!-- 9 Auto-Stacking Horizontal Mini Zone Docks (Functional Utility Cards) -->
                                                <StackPanel x:Name="MiniZoneStackTopLeft" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                <StackPanel x:Name="MiniZoneStackTopCenter" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <StackPanel x:Name="MiniZoneStackTopRight" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                <StackPanel x:Name="MiniZoneStackCenterLeft" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                <StackPanel x:Name="MiniZoneStackCenter" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <StackPanel x:Name="MiniZoneStackCenterRight" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                <StackPanel x:Name="MiniZoneStackBottomLeft" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                <StackPanel x:Name="MiniZoneStackBottomCenter" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <controls:StylizedWeatherWidget x:Name="MiniPreviewWeatherWidget"
                                                                                    WeatherScale="0.25"
                                                                                    CanDrag="True"
                                                                                    DragStarting="OnWidgetBadgeDragStarting"
                                                                                    Tag="Weather"
                                                                                    Visibility="Collapsed"/>

                                                    <controls:StylizedCalendarWidget x:Name="MiniPreviewCalendarWidget"
                                                                                     CalendarScale="0.25"
                                                                                     CanDrag="True"
                                                                                     DragStarting="OnWidgetBadgeDragStarting"
                                                                                     Tag="Calendar"
                                                                                     Visibility="Collapsed"/>

                                                    <controls:StylizedMediaWidget x:Name="MiniPreviewMediaWidget"
                                                                                  MediaScale="0.25"
                                                                                  CanDrag="True"
                                                                                  DragStarting="OnWidgetBadgeDragStarting"
                                                                                  Tag="Media"
                                                                                  Visibility="Collapsed"/>

                                                    <controls:StylizedPerformanceWidget x:Name="MiniPreviewPerformanceWidget"
                                                                                        PerformanceScale="0.25"
                                                                                        CanDrag="True"
                                                                                        DragStarting="OnWidgetBadgeDragStarting"
                                                                                        Tag="Performance"
                                                                                        Visibility="Collapsed"/>
                                                </StackPanel>
                                                <StackPanel x:Name="MiniZoneStackBottomRight" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Monitor Stand Neck & Base -->
                                    <Border Width="32" Height="14" Background="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Center"/>
                                    <Border Width="110" Height="6" CornerRadius="3" Background="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </NavigationView>

        <!-- SOURCE TRANSITIONS & EFFECTS DIALOG -->
        <ContentDialog x:Name="DialogSourceEffects"
                       Title="Transitions &amp; Effects"
                       PrimaryButtonText="Done"
                       SecondaryButtonText="Reset to Defaults"
                       DefaultButton="Primary"
                       PrimaryButtonClick="OnSourceEffectsDoneClicked"
                       SecondaryButtonClick="OnSourceEffectsResetClicked">
            <StackPanel Spacing="16" Width="440">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="TxtDialogSourceTitle" Text="Folder Name" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtDialogSourcePath" Text="C:\Path\To\Folder" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Transition Style -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Transition Style" FontWeight="Medium" FontSize="13"/>
                    <ComboBox x:Name="ComboDialogTransitionStyle" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Crossfade (Smooth Blend)"/>
                        <ComboBoxItem Content="Fade to Black (Cinema Cut)"/>
                        <ComboBoxItem Content="Slide (Push)"/>
                        <ComboBoxItem Content="Cut (Instant Swap)"/>
                    </ComboBox>
                </StackPanel>

                <!-- Transition Duration -->
                <StackPanel Spacing="4">
                    <Grid>
                        <TextBlock Text="Transition Duration" FontWeight="Medium" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtDialogTransitionDuration" Text="1.5s" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Grid>
                    <Slider x:Name="SliderDialogTransitionDuration" Minimum="0.2" Maximum="4.0" StepFrequency="0.2" ValueChanged="OnDialogSettingChanged"/>
                </StackPanel>

                <!-- Photo Display Duration -->
                <StackPanel Spacing="4">
                    <Grid>
                        <TextBlock Text="Photo Display Duration" FontWeight="Medium" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtDialogPhotoDuration" Text="8s" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Grid>
                    <Slider x:Name="SliderDialogPhotoDuration" Minimum="3" Maximum="30" StepFrequency="1" ValueChanged="OnDialogSettingChanged"/>
                </StackPanel>

                <!-- Ken Burns Motion -->
                <Grid>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Ken Burns Motion on Photos" FontWeight="Medium" FontSize="13"/>
                        <TextBlock Text="Subtle pan and zoom animation for still images." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="ToggleDialogKenBurns" HorizontalAlignment="Right" Margin="0,-4,0,0"/>
                </Grid>

                <!-- Screen Fit Mode -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Screen Fit Mode" FontWeight="Medium" FontSize="13"/>
                    <ComboBox x:Name="ComboDialogFitMode" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Fill Screen (Crop to Fill)"/>
                        <ComboBoxItem Content="Fit to Screen (Letterbox / Black Bars)"/>
                        <ComboBoxItem Content="Stretch to Fill"/>
                        <ComboBoxItem Content="Center 1:1 (No Scaling)"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
